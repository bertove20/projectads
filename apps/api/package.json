{
  "name": "@eaip/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:api": "nest start --watch --entryFile main",
    "dev:tracker": "nest start --watch --entryFile tracker.main",
    "dev:worker": "nest start --watch --entryFile worker.main",
    "start:api": "node dist/main.js",
    "start:tracker": "node dist/tracker.main.js",
    "start:worker": "node dist/worker.main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/seed.js",
    "db:seed:dev": "ts-node --transpile-only src/seed.ts",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "bullmq": "5.63.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "4.4.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ua-parser-js": "1.0.41",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.9",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "@types/ua-parser-js": "0.7.39",
    "jest": "29.7.0",
    "pino-pretty": "13.1.2",
    "playwright": "1.64.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
