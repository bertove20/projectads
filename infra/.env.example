# ─── Salin ke infra/.env lalu isi. JANGAN commit file .env ───

APP_VERSION=latest

# Domain — arahkan DNS A record ketiganya ke IP VPS sebelum menjalankan compose.
#   admin.* = login & dashboard tim (jangan dibagikan ke luar)
#   trk.*   = tracking link, click-out, JS SDK (dipasang di jaringan iklan & landing page)
#   pb.*    = postback masuk dari affiliate network
ADMIN_DOMAIN=admin.trkads.org
TRACKER_DOMAIN=trk.trkads.org
POSTBACK_DOMAIN=pb.trkads.org
ACME_EMAIL=you@example.com

DASHBOARD_ORIGIN=https://admin.trkads.org
TRACKER_PUBLIC_URL=https://trk.trkads.org
POSTBACK_PUBLIC_URL=https://pb.trkads.org
# Kunci endpoint internal penerbitan sertifikat domain kustom — buat dengan: openssl rand -hex 24
INTERNAL_ASK_KEY=GANTI_dengan_openssl_rand_hex_24
# Tujuan bila campaign tidak ditemukan/nonaktif
DEFAULT_FALLBACK_URL=https://www.google.com

# Database & Redis (hanya dapat diakses dari jaringan Docker internal)
POSTGRES_USER=eaip
POSTGRES_PASSWORD=GANTI_dengan_openssl_rand_hex_24
POSTGRES_DB=eaip
REDIS_PASSWORD=GANTI_dengan_openssl_rand_hex_24

# Secrets — buat masing-masing dengan:  openssl rand -base64 32
APP_ENCRYPTION_KEY=GANTI_base64_32_byte
APP_ENCRYPTION_KEY_VERSION=1
IP_HASH_SECRET=GANTI_dengan_openssl_rand_hex_32

# Session & keamanan
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=7
COOKIE_SECURE=true
MFA_ENFORCE_ADMIN=true
TRUST_PROXY_HOPS=1
ALLOW_INSECURE_POSTBACK=false
ALLOW_PRIVATE_POSTBACK_TARGETS=false

LOG_LEVEL=info

# Phase 2 — sinkronisasi jaringan & alert
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=3
RECON_THRESHOLD_PCT=15
RECON_MIN_CLICKS=100
# Jangan diubah di produksi (hanya untuk mock lokal):
# ROLLERADS_API_BASE=https://api.rollerads.com/v2
# TELEGRAM_API_BASE=https://api.telegram.org
# DISCORD_API_BASE=https://discord.com/api/v10
# Long polling perintah Telegram (detik)
# TELEGRAM_POLL_TIMEOUT_SECONDS=25
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# API key OpenRouter TIDAK disimpan di .env: diatur Owner lewat dashboard (AI Workspace → Pengaturan), tersimpan terenkripsi.
# Batas waktu satu request model (ms):
# AI_REQUEST_TIMEOUT_MS=90000

# Akun pertama (dipakai sekali saat migrate/seed; hapus password setelah login pertama)
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=My Organization

# Backup offsite terenkripsi ke Cloudflare R2 (jalankan scripts/offsite-setup.sh setelah diisi)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eaip-backups
# Diisi otomatis oleh offsite-setup.sh:
# BACKUP_REMOTE=eaip-r2:eaip-backups/eaip
# BACKUP_PASSPHRASE_FILE=/root/.eaip-backup-passphrase
# OFFSITE_RETENTION_DAYS=30
