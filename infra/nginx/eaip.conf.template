# EAIP — server block Nginx (mode "Nginx di depan"). Dirender oleh infra/scripts/nginx-setup.sh.
# Hanya menangani ${ADMIN_DOMAIN}, ${TRACKER_DOMAIN}, ${POSTBACK_DOMAIN}; domain lain tetap ke default_server yang sudah ada.

# IP klien asli diteruskan ke aplikasi (TRUST_PROXY_HOPS=1). Header dari klien DITIMPA, bukan ditambahkan, agar tidak bisa dipalsukan.
map $http_upgrade $eaip_connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP: hanya tantangan Let's Encrypt + redirect ke HTTPS ──
server {
    listen 80;
    listen [::]:80;
    server_name ${ADMIN_DOMAIN} ${TRACKER_DOMAIN} ${POSTBACK_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/eaip-acme;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Admin: dashboard + API. Tidak pernah muncul di tracking link / URL postback. ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 2m;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
    }
    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $eaip_connection_upgrade;
        proxy_pass http://127.0.0.1:3000;
    }
}

# ── Tracking: klik, click-out, JS SDK & event saja ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${TRACKER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 64k;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;

    location ~ ^/(c/|click-out$|sdk\.js$|e$|healthz$) {
        proxy_pass http://127.0.0.1:4100;
    }
    location / {
        return 404;
    }
}

# ── Postback masuk dari affiliate network saja ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${POSTBACK_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 64k;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;

    location ~ ^/(postback/in/|healthz$) {
        proxy_pass http://127.0.0.1:4100;
    }
    location / {
        return 404;
    }
}
